# Local view of the active school worker. Paths only; never copy source credentials here.
SCHOOL_PYTHON=/absolute/path/to/python
SCHOOL_OPERATIONS_PATH=/absolute/path/to/Sync/operations
SCHOOL_SNAPSHOT_PATH=/absolute/path/to/private/state/snapshot.json
# Cloud snapshots require a separate authenticated durable school store (not commissioned).
# Public hosting is locked until authentication and that store are commissioned.
