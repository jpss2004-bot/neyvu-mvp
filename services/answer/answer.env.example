# Hosted answer service configuration (example only; never commit real values).
SCHOOL_ANSWER_ORIGIN=https://staging.example.invalid
SCHOOL_ANSWER_WORKER_KEY=
# Claude Haiku behind the existing provider switch; leave the key empty to stay local.
SCHOOL_BETA_MODEL_PROVIDER=anthropic
SCHOOL_BETA_ANTHROPIC_MODEL=claude-haiku-5-5
SCHOOL_BETA_ANTHROPIC_EFFORT=low
ANTHROPIC_API_KEY=
# Optional local-model fallback (Ollama); required when the provider is ollama.
SCHOOL_ANSWER_OLLAMA_URL=
# Workstream D flags, all off by default.
SCHOOL_BETA_KNOWLEDGE_GRAPH=0
SCHOOL_BETA_QUESTION_REWRITE=0
SCHOOL_BETA_TOOL_LOOP=0
SCHOOL_BETA_TOOL_LOOP_STEPS=4
SCHOOL_BETA_LEARNER_PROFILE=0
